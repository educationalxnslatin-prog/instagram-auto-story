# Учётные данные Instagram (НЕ коммитьте этот файл!)
IG_USERNAME=your_instagram_login
IG_PASSWORD=your_instagram_password

# Опционально: код двухфакторной аутентификации (если включён 2FA)
# Либо TOTP-секрет (без пробелов, в формате base32), либо оставьте пустым
IG_TOTP_SEED=

# Опционально: прокси (если нужно)
# Пример: http://user:pass@host:port
IG_PROXY=
